# ==============================================================================
# EVENTORA ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Supabase Project Credentials
# Obtain these from your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Application Base URL
VITE_APP_URL=http://localhost:3000

# 3. Default Currency & Localization
VITE_DEFAULT_CURRENCY=ETB
VITE_PLATFORM_NAME=EVENTORA

# 4. Optional SMS OTP Configuration (Twilio / Supabase SMS Provider)
# Note: In production, SMS is handled securely via Supabase Auth SMS Provider
VITE_SMS_PROVIDER_CONFIGURED=false

# 5. Payment Gateways (Client keys / Modes)
# Real gateways verify payments securely via webhook callbacks
VITE_TELEBIRR_ENABLED=true
VITE_CHAPA_ENABLED=true
VITE_STRIPE_ENABLED=true
VITE_PAYMENT_TEST_MODE=true
